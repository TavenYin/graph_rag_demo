# Docker Compose creates this database locally in Task 3.
DATABASE_URL=postgresql+asyncpg://graph_rag:graph_rag@localhost:5432/graph_rag_demo

# Keep false for tests. Set true and provide a local-only key for real demos.
USE_REAL_CLIENTS=false
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

CHUNK_SIZE=400
CHUNK_OVERLAP=80

# Cosine distance threshold: similarity > 0.6 is distance < 0.4.
VECTOR_MAX_DISTANCE=0.4
